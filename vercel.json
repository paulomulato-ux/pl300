{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "docs"
      }
    }
  ],
  "routes": [
    { "src": "/pl300$", "dest": "/index.html" },
    { "src": "/pl300/(.*)", "dest": "/$1" }
  ],
  "redirects": [
    { "source": "/", "destination": "/pl300", "permanent": true }
  ]
}
